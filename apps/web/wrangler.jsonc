{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberblade3d-web",
  "compatibility_date": "2026-08-01",
  // Served from the custom domain only; disables <name>.<subdomain>.workers.dev.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
